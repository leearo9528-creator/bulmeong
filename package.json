{
  "name": "bulmeong-widget",
  "productName": "Bulmeong",
  "version": "0.1.0",
  "description": "바탕화면 아래에 띄워두는 작은 불멍 위젯",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "app.bulmeong.widget",
    "productName": "Bulmeong",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "vendor/**",
      "build/tray.png"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Bulmeong.exe"
    }
  }
}